# Application
APP_NAME=FinSight
APP_ENV=development
# Prefer false in committed defaults; set true only for local debugging.
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# CORS — comma-separated origins allowed to call the API from the browser
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (psycopg v3 driver) — replace USER with your local Postgres role
DATABASE_URL=postgresql+psycopg://USER@localhost:5432/finsight
